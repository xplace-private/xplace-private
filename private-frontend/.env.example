# Public API origin. Vite inlines this into the client bundle — never put secrets here.
# Copy to `.env.development.local` to override the committed development value.
#
# Build modes and their API origin:
# development (local Vite server): /api, proxied to http://localhost:8000
# dev (deployed development env): https://backend.dev.kube-main.x.place
# staging: https://back-stage.x.place
# production: https://back.x.place
VITE_API_BASE_URL=

# Public hash of a released Crowdin OTA distribution. Leave empty to disable OTA.
# Vite inlines this value into the client bundle, so it must not contain a secret.
VITE_CROWDIN_DISTRIBUTION_HASH=
